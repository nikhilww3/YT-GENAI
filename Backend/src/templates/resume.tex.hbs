%-------------------------
% Resume in Latex — user's own template (originally derived from
% jakegut/resume / sb2nov/resume, MIT licensed), with two changes verified
% necessary for this pipeline:
%  1. glyphtounicode/pdfgentounicode guarded to pdfTeX only (Tectonic's
%     XeTeX-based engine doesn't define those primitives; XeTeX doesn't need
%     the copy-paste-ligature fix they exist for, verified via pdf-parse).
%  2. FontAwesome icons removed from the contact line — verified via
%     pdf-parse that their glyphs have no ToUnicode mapping, so they extract
%     as garbage characters right next to the phone/email text, which
%     directly worked against this feature's ATS-parsability goal.
%
% Note: this file is a fixed skeleton — resume.service.js is the only thing
% that fills it in, via buildTemplateContext(). Every substituted value below
% already holds a fully LaTeX-escaped, pre-brace-wrapped string built in JS,
% not raw AI output — so no literal LaTeX brace in this file ever sits
% directly next to a Handlebars delimiter (that combination is ambiguous with
% Handlebars' raw-block syntax). Keep it that way if you edit this file.
%------------------------

\documentclass[letterpaper,11pt]{article}

\usepackage{latexsym}
\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage{marvosym}
\usepackage[usenames,dvipsnames]{color}
\usepackage{verbatim}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{tabularx}
\usepackage{iftex}
\ifPDFTeX
  \input{glyphtounicode}
\fi

\pagestyle{fancy}
\fancyhf{}
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\addtolength{\oddsidemargin}{-0.6in}
\addtolength{\evensidemargin}{-0.5in}
\addtolength{\textwidth}{1.19in}
\addtolength{\topmargin}{-.7in}
\addtolength{\textheight}{1.4in}

\urlstyle{same}

\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

\titleformat{\section}{
  \vspace{-4pt}\scshape\raggedright\large\bfseries
}{}{0em}{}[\color{black}\titlerule \vspace{-5pt}]

\ifPDFTeX
  \pdfgentounicode=1
\fi

\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{1.0\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & \textbf{\small #2} \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{1.001\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 & \textbf{\small #2}\\
    \end{tabular*}\vspace{-7pt}
}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.0in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

\begin{document}

%----------HEADING----------
\begin{center}
    {{{headerName}}} \\ \vspace{1pt}
    {{{headerLocation}}} \\ \vspace{1pt}
    {{{headerContact}}}
    \vspace{-8pt}
\end{center}

%-----------EDUCATION-----------
{{#if education}}
\section{Education}
  \resumeSubHeadingListStart
  {{#each education}}
    \resumeSubheading
      {{{line1}}}
      {{{line2}}}
  {{/each}}
  \resumeSubHeadingListEnd
{{/if}}

%-----------SUMMARY-----------
{{#if summary}}
\section{Summary}
  \small {{{summary}}}
{{/if}}

%-----------EXPERIENCE-----------
{{#if experience}}
\vspace{-5pt}
\section{Experience}
  \resumeSubHeadingListStart
  {{#each experience}}
    \resumeSubheading
      {{{headingLine1}}}
      {{{headingLine2}}}
      {{#if bullets}}
      \resumeItemListStart
      {{#each bullets}}
        \resumeItem{ {{{this}}} }
      {{/each}}
      \resumeItemListEnd
      {{/if}}
  {{/each}}
  \resumeSubHeadingListEnd
\vspace{-14pt}
{{/if}}

%-----------PROJECTS-----------
{{#if projects}}
\section{Projects}
    \vspace{-5pt}
    \resumeSubHeadingListStart
    {{#each projects}}
      \resumeProjectHeading
          {{{headingLine}}}
          {{#if bullets}}
          \resumeItemListStart
          {{#each bullets}}
            \resumeItem{ {{{this}}} }
          {{/each}}
          \resumeItemListEnd
          {{/if}}
    {{/each}}
    \resumeSubHeadingListEnd
\vspace{-14pt}
{{/if}}

%-----------TECHNICAL SKILLS-----------
{{#if skills}}
\section{Technical Skills}
   \resumeItemListStart
   {{#each skills}}
     \resumeItem{ {{{line}}} }
   {{/each}}
   \resumeItemListEnd
{{/if}}

\end{document}
