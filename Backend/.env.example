# Copy this file to .env and fill in your values:
#   cp .env.example .env

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/yt-genai
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URL=

# Secret key for signing JWT tokens (use a long random string)
JWT_SECRET=
