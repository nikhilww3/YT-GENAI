# Copy this file to .env and fill in your values:
#   cp .env.example .env

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/yt-genai
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URL=

# Secret key for signing JWT tokens (use a long random string)
JWT_SECRET=

# Google Gemini API key — required, used for interview report generation
# (default provider) and the tailored-resume feature.
# Get one at: https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=

# Optional: lets users pick "NVIDIA" as a provider when generating an
# interview report. Free tier, no credit card. Get one at:
# https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# Optional: lets users pick "Hugging Face" as a provider when generating an
# interview report. Free tier. Get one at:
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
